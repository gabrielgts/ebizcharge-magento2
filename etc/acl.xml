<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Gtstudio_Ebizcharge::config"
                                      title="Gtstudio EBizCharge Section"
                                      sortOrder="500"/>
                        </resource>
                    </resource>
                </resource>
                <resource id="Magento_Sales::sales">
                    <resource id="Gtstudio_Ebizcharge::subscription_root"
                              title="EBizCharge Subscriptions"
                              sortOrder="100">
                        <resource id="Gtstudio_Ebizcharge::subscription_view"
                                  title="View Subscriptions"
                                  sortOrder="10"/>
                        <resource id="Gtstudio_Ebizcharge::subscription_manage"
                                  title="Manage Subscriptions (pause/resume/cancel/charge)"
                                  sortOrder="20"/>
                    </resource>
                    <resource id="Gtstudio_Ebizcharge::debug_trace_view"
                              title="EBizCharge Debug Traces"
                              sortOrder="110"/>
                </resource>
                <resource id="Magento_Customer::customer">
                    <resource id="Magento_Customer::manage">
                        <resource id="Magento_Customer::actions">
                            <resource id="Gtstudio_Ebizcharge::customer_identity_manage"
                                      title="Verify and Sync EBizCharge Customer Identity"
                                      sortOrder="40"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
