<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="payment_method_assign_data_gtstudio_ebizcharge">
        <observer name="gtstudio_ebizcharge_data_assign"
                  instance="Gtstudio\Ebizcharge\Observer\DataAssignObserver"/>
    </event>
    <event name="payment_method_assign_data_gtstudio_ebizcharge_cc_vault">
        <observer name="gtstudio_ebizcharge_vault_data_assign"
                  instance="Gtstudio\Ebizcharge\Observer\DataAssignObserver"/>
    </event>
    <event name="payment_method_assign_data_gtstudio_ebizcharge_ach">
        <observer name="gtstudio_ebizcharge_ach_data_assign"
                  instance="Gtstudio\Ebizcharge\Observer\DataAssignObserver"/>
    </event>
    <event name="payment_method_assign_data_gtstudio_ebizcharge_ach_vault">
        <observer name="gtstudio_ebizcharge_ach_vault_data_assign"
                  instance="Gtstudio\Ebizcharge\Observer\DataAssignObserver"/>
    </event>

    <!-- Reject invalid recurring checkouts before payment authorization. -->
    <event name="sales_model_service_quote_submit_before">
        <observer name="gtstudio_ebizcharge_validate_subscription_checkout"
                  instance="Gtstudio\Ebizcharge\Observer\ValidateSubscriptionCheckout"/>
    </event>

    <!-- Create rows only after Magento has saved the order payment and its native Vault token. -->
    <event name="checkout_submit_all_after">
        <observer name="gtstudio_ebizcharge_create_subscription_from_order"
                  instance="Gtstudio\Ebizcharge\Observer\CreateSubscriptionFromOrder"/>
    </event>
</config>
