<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="gtstudio_ebizcharge_customer_identity" resource="default" engine="innodb"
           comment="EBizCharge Customer Identity Mapping">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true"
                comment="Entity ID"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="false"
                comment="Magento Customer ID"/>
        <column xsi:type="varchar" name="ebiz_customer_id" length="200" nullable="false"
                comment="ERP-facing EBizCharge Customer ID"/>
        <column xsi:type="varchar" name="customer_internal_id" length="200" nullable="true"
                comment="EBizCharge Customer Internal ID"/>
        <column xsi:type="varchar" name="customer_number" length="200" nullable="true"
                comment="EBizCharge Customer Number (CustNum)"/>
        <column xsi:type="varchar" name="sync_direction" length="11" nullable="true"
                comment="Legacy-compatible Sync Direction"/>
        <column xsi:type="timestamp" name="last_synced_at" nullable="true" default="NULL"
                comment="Last Successful Remote Verification"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP"
                on_update="true"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="GTSTUDIO_EBIZCHARGE_CUST_IDENTITY_CUSTOMER">
            <column name="customer_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="GTSTUDIO_EBIZCHARGE_CUST_IDENTITY_CUSTOMER_FK"
                    table="gtstudio_ebizcharge_customer_identity" column="customer_id"
                    referenceTable="customer_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
        <index referenceId="GTSTUDIO_EBIZCHARGE_CUST_IDENTITY_EBIZ_ID" indexType="btree">
            <column name="ebiz_customer_id"/>
        </index>
    </table>

    <table name="gtstudio_ebizcharge_subscription" resource="default" engine="innodb" comment="EBizCharge subscriptions (Magento drives the schedule)">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="false" comment="Magento customer"/>
        <column xsi:type="int" name="vault_payment_token_id" unsigned="true" nullable="true" comment="Vault token used for charging; nullable so we can detach when expired"/>
        <column xsi:type="varchar" name="status" length="16" nullable="false" default="active" comment="active|paused|cancelled|expired|failing|completed"/>
        <column xsi:type="varchar" name="frequency" length="16" nullable="false" comment="daily|weekly|bi-weekly|monthly|bi-monthly|quarterly|bi-annually|annually"/>
        <column xsi:type="decimal" name="amount" precision="12" scale="4" nullable="false" comment="Locked item subtotal before renewal tax and shipping"/>
        <column xsi:type="varchar" name="currency_code" length="3" nullable="false" default="USD"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" default="0"/>
        <column xsi:type="date" name="next_bill_date" nullable="false" comment="When the next charge is due"/>
        <column xsi:type="datetime" name="last_charged_at" nullable="true"/>
        <column xsi:type="date" name="start_date" nullable="false"/>
        <column xsi:type="date" name="end_date" nullable="true"/>
        <column xsi:type="int" name="max_cycles" nullable="true" comment="Null = indefinite"/>
        <column xsi:type="int" name="completed_cycles" unsigned="true" nullable="false" default="0"/>
        <column xsi:type="int" name="failure_count" unsigned="true" nullable="false" default="0" comment="Consecutive failures; resets on success"/>
        <column xsi:type="varchar" name="label" length="255" nullable="true"/>
        <column xsi:type="int" name="source_order_id" unsigned="true" nullable="true"/>
        <column xsi:type="varchar" name="ebizcharge_recurring_id" length="64" nullable="true" comment="Optional, only if mirrored to gateway portal"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="GTSTUDIO_EBIZCHARGE_SUB_CUSTOMER_ID"
                    table="gtstudio_ebizcharge_subscription" column="customer_id"
                    referenceTable="customer_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="GTSTUDIO_EBIZCHARGE_SUB_VAULT_TOKEN_ID"
                    table="gtstudio_ebizcharge_subscription" column="vault_payment_token_id"
                    referenceTable="vault_payment_token" referenceColumn="entity_id" onDelete="SET NULL"/>
        <constraint xsi:type="foreign" referenceId="GTSTUDIO_EBIZCHARGE_SUB_SOURCE_ORDER_ID"
                    table="gtstudio_ebizcharge_subscription" column="source_order_id"
                    referenceTable="sales_order" referenceColumn="entity_id" onDelete="SET NULL"/>
        <index referenceId="GTSTUDIO_EBIZCHARGE_SUB_STATUS_NEXT_BILL" indexType="btree">
            <column name="status"/>
            <column name="next_bill_date"/>
        </index>
        <index referenceId="GTSTUDIO_EBIZCHARGE_SUB_CUSTOMER" indexType="btree">
            <column name="customer_id"/>
        </index>
    </table>

    <table name="gtstudio_ebizcharge_subscription_item" resource="default" engine="innodb" comment="Line items for a subscription (price locked at creation)">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true"/>
        <column xsi:type="int" name="subscription_id" unsigned="true" nullable="false"/>
        <column xsi:type="int" name="product_id" unsigned="true" nullable="false"/>
        <column xsi:type="varchar" name="sku" length="64" nullable="false"/>
        <column xsi:type="decimal" name="qty" precision="12" scale="4" nullable="false" default="1.0000"/>
        <column xsi:type="decimal" name="price" precision="12" scale="4" nullable="false" comment="Snapshot unit price excluding tax; immutable"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="GTSTUDIO_EBIZCHARGE_SUB_ITEM_SUBSCRIPTION_ID"
                    table="gtstudio_ebizcharge_subscription_item" column="subscription_id"
                    referenceTable="gtstudio_ebizcharge_subscription" referenceColumn="entity_id" onDelete="CASCADE"/>
        <index referenceId="GTSTUDIO_EBIZCHARGE_SUB_ITEM_SUBSCRIPTION" indexType="btree">
            <column name="subscription_id"/>
        </index>
    </table>

    <table name="gtstudio_ebizcharge_debug_trace" resource="default" engine="innodb" comment="Captured SOAP request/response traces for admin debugging">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true"/>
        <column xsi:type="varchar" name="correlation_id" length="64" nullable="false" default="" comment="Joins back to the gtstudio_ebizcharge.log line(s)"/>
        <column xsi:type="varchar" name="soap_method" length="64" nullable="false" comment="runTransaction, runCustomerTransaction, etc."/>
        <column xsi:type="varchar" name="command" length="32" nullable="true" comment="authonly, sale, capture, refund, creditvoid, check, checkcredit"/>
        <column xsi:type="varchar" name="endpoint" length="255" nullable="false"/>
        <column xsi:type="text" name="request_summary" nullable="true" comment="JSON-encoded redacted request body"/>
        <column xsi:type="text" name="response_summary" nullable="true" comment="JSON-encoded redacted response body"/>
        <column xsi:type="varchar" name="result_code" length="2" nullable="true"/>
        <column xsi:type="varchar" name="ref_num" length="32" nullable="true"/>
        <column xsi:type="int" name="latency_ms" unsigned="true" nullable="false" default="0"/>
        <column xsi:type="varchar" name="error_message" length="512" nullable="true"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="GTSTUDIO_EBIZCHARGE_DEBUG_TRACE_CORRELATION_ID" indexType="btree">
            <column name="correlation_id"/>
        </index>
        <index referenceId="GTSTUDIO_EBIZCHARGE_DEBUG_TRACE_CREATED_AT" indexType="btree">
            <column name="created_at"/>
        </index>
    </table>

    <table name="gtstudio_ebizcharge_subscription_charge" resource="default" engine="innodb" comment="Every charge attempt (success or failure)">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true"/>
        <column xsi:type="int" name="subscription_id" unsigned="true" nullable="false"/>
        <column xsi:type="datetime" name="scheduled_for" nullable="false"/>
        <column xsi:type="datetime" name="attempted_at" nullable="true"/>
        <column xsi:type="varchar" name="status" length="16" nullable="false" default="pending" comment="pending|in_progress|succeeded|failed|skipped"/>
        <column xsi:type="int" name="attempt_count" unsigned="true" nullable="false" default="0"/>
        <column xsi:type="int" name="magento_order_id" unsigned="true" nullable="true"/>
        <column xsi:type="varchar" name="gateway_ref_num" length="32" nullable="true"/>
        <column xsi:type="varchar" name="error_code" length="32" nullable="true"/>
        <column xsi:type="text" name="error_message" nullable="true"/>
        <column xsi:type="varchar" name="correlation_id" length="64" nullable="false" default=""/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="GTSTUDIO_EBIZCHARGE_SUB_CHARGE_SUBSCRIPTION_ID"
                    table="gtstudio_ebizcharge_subscription_charge" column="subscription_id"
                    referenceTable="gtstudio_ebizcharge_subscription" referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="GTSTUDIO_EBIZCHARGE_SUB_CHARGE_ORDER_ID"
                    table="gtstudio_ebizcharge_subscription_charge" column="magento_order_id"
                    referenceTable="sales_order" referenceColumn="entity_id" onDelete="SET NULL"/>
        <constraint xsi:type="unique" referenceId="GTSTUDIO_EBIZCHARGE_SUB_CHARGE_IDEMPOTENCY">
            <column name="subscription_id"/>
            <column name="scheduled_for"/>
            <column name="attempt_count"/>
        </constraint>
        <index referenceId="GTSTUDIO_EBIZCHARGE_SUB_CHARGE_STATUS_SCHEDULED" indexType="btree">
            <column name="status"/>
            <column name="scheduled_for"/>
        </index>
    </table>

</schema>
