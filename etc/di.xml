            <argument name="valueHandlerPool" xsi:type="object">GtstudioEbizchargeAchValueHandlerPool</argument>
            <argument name="vaultProvider" xsi:type="object">GtstudioEbizchargeAchFacade</argument>
            <argument name="code" xsi:type="string">gtstudio_ebizcharge_ach_vault</argument>
        </arguments>
    </virtualType>

    <type name="Magento\Vault\Model\PaymentTokenRepository">
        <plugin name="gtstudio_ebizcharge_delete_remote_card_profile"
                type="Gtstudio\Ebizcharge\Plugin\Vault\DeleteStoredCardPlugin"
                sortOrder="20"/>
    </type>

    <!-- ===================== CLI COMMANDS ===================== -->
    <type name="Magento\Framework\Console\CommandList">
