<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <payment>
            <gtstudio_ebizcharge>
                <active>0</active>
                <model>GtstudioEbizchargeFacade</model>
                <title>Credit Card (EBizCharge)</title>
                <payment_action>authorize</payment_action>
                <cctypes>VI,MC,AE,DI,JCB</cctypes>
                <endpoint_mode>production</endpoint_mode>
                <endpoint_url_override></endpoint_url_override>
                <description>Magento Order [orderid]</description>
                <software_tag>Magento2-Gtstudio</software_tag>
                <soap_timeout>60</soap_timeout>
                <soap_connect_timeout>30</soap_connect_timeout>
                <debug>0</debug>
                <can_authorize>1</can_authorize>
                <can_authorize_vault>1</can_authorize_vault>
                <can_capture_vault>1</can_capture_vault>
                <can_sale>1</can_sale>
                <can_capture>1</can_capture>
                <can_capture_partial>1</can_capture_partial>
                <can_refund>1</can_refund>
                <can_refund_partial_per_invoice>1</can_refund_partial_per_invoice>
                <can_void>1</can_void>
                <can_use_internal>1</can_use_internal>
                <can_use_checkout>1</can_use_checkout>
                <is_gateway>1</is_gateway>
                <currency>USD</currency>
                <subscription_failure_threshold_failing>3</subscription_failure_threshold_failing>
                <subscription_failure_threshold_cancel>5</subscription_failure_threshold_cancel>
                <subscription_upcoming_charge_email_days>3</subscription_upcoming_charge_email_days>
                <subscription_card_expiring_email_days>30,7,1</subscription_card_expiring_email_days>
            </gtstudio_ebizcharge>
            <gtstudio_ebizcharge_cc_vault>
                <model>GtstudioEbizchargeVaultFacade</model>
                <title>Saved Cards (EBizCharge)</title>
                <active>1</active>
                <can_authorize>1</can_authorize>
                <can_sale>1</can_sale>
                <can_capture>1</can_capture>
                <can_capture_vault>1</can_capture_vault>
                <can_refund>1</can_refund>
                <can_refund_partial_per_invoice>1</can_refund_partial_per_invoice>
                <can_void>1</can_void>
                <can_use_internal>0</can_use_internal>
            </gtstudio_ebizcharge_cc_vault>
            <gtstudio_ebizcharge_ach>
                <active>0</active>
                <model>GtstudioEbizchargeAchFacade</model>
                <title>Bank Account (ACH)</title>
                <payment_action>authorize_capture</payment_action>
                <description>Magento Order [orderid]</description>
                <sort_order>20</sort_order>
                <can_authorize>0</can_authorize>
                <can_capture>1</can_capture>
                <can_refund>1</can_refund>
                <can_refund_partial_per_invoice>1</can_refund_partial_per_invoice>
                <can_void>1</can_void>
                <can_use_internal>1</can_use_internal>
                <can_use_checkout>1</can_use_checkout>
                <is_gateway>1</is_gateway>
                <currency>USD</currency>
            </gtstudio_ebizcharge_ach>
            <gtstudio_ebizcharge_ach_vault>
                <model>GtstudioEbizchargeAchVaultFacade</model>
                <title>Saved Bank Accounts (EBizCharge)</title>
                <active>1</active>
                <can_capture>1</can_capture>
                <can_capture_vault>1</can_capture_vault>
                <can_refund>1</can_refund>
                <can_refund_partial_per_invoice>1</can_refund_partial_per_invoice>
                <can_void>1</can_void>
                <can_use_internal>1</can_use_internal>
            </gtstudio_ebizcharge_ach_vault>
        </payment>
    </default>
</config>
